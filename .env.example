# ============================================================================
# C&R ESG Event - 환경변수 예시
# 사용법: 이 파일을 복사하여 .env.local 생성 후 실제 값 입력
#   cp .env.example .env.local
#
# 원칙:
#   - .env.local은 git에 커밋 금지 (.gitignore에 등록됨)
#   - 모든 클라이언트 환경변수는 VITE_ prefix 필수 (Vite 표준)
#   - 도메인은 절대 하드코딩하지 않음 — 코드에서 window.location.origin 사용
# ============================================================================

# Supabase (C&R Space와 동일 인스턴스 공유)
# Project ref: jjzcqpbwkkujttwxksvy
VITE_SUPABASE_URL=https://jjzcqpbwkkujttwxksvy.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...여기에_anon_key_입력

# ============================================================================
# 인증 관련 (Phase 0-2B에서 인증 방식 확정 후 활성화)
# ============================================================================

# (A) Supabase Auth + Azure OAuth Provider 사용 시: 환경변수 불필요
#     Supabase Dashboard → Authentication → Providers → Azure 활성화로 충분
#     이 경우 코드에서는 supabase.auth.signInWithOAuth({ provider: 'azure' }) 호출

# (B) MSAL 직접 사용 시: 아래 활성화 (Azure AD 앱 등록 필요)
# VITE_AZURE_CLIENT_ID=
# VITE_AZURE_TENANT_ID=

# ============================================================================
# 앱 메타
# ============================================================================
VITE_APP_NAME="C&R 29주년 ESG 이벤트"

# 빌드 환경 식별용 (dev/staging/production)
VITE_APP_ENV=development

# 모금 목표액 (DB의 esg_settings.donation_goal과 별개, 클라이언트 fallback)
# 실제 운영 시 DB 값이 우선
VITE_DONATION_GOAL_FALLBACK=5000000
